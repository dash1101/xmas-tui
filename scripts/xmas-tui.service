[Unit]
Description=xmas-tui live Christmas wallpaper
PartOf=graphical-session.target
After=graphical-session.target plasma-plasmashell.service
# never give up restarting
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=@DIR@/scripts/xmas-wallpaper.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
